# Copy to .env beside compose.yaml. Every value here has a working default, so
# an empty .env is valid — this file exists to show what is adjustable.

# --------------------------------------------------------------------- ports ---
# The only port that can conflict with anything else on your machine. Everything
# else below lives inside the container's own network namespace.
#
# Defaults avoid two ranges on purpose: the crowded registered-service space
# below ~20000, and 32768 and above, where Linux allocates ephemeral source
# ports for outgoing connections and a published port can be taken from under
# you. Pick anything in 20000–32767 that is free:
#
#   ss -tlnp | awk '{print $4}' | grep -oE '[0-9]+$' | sort -n | uniq
#
REDACTLY_HOST_PORT=28419

# In-container ports. Changing these needs `--build`, because the viewer's proxy
# destination is baked into the bundle at build time. There is no reason to
# change them for conflict reasons; they cannot collide with the host.
REDACTLY_WEB_PORT=24680
REDACTLY_API_PORT=24681

# Interface the published port binds to. Loopback keeps the app reachable only
# through your reverse proxy. Setting 0.0.0.0 exposes it directly, but WebMCP
# will not activate over plain HTTP, so the tools never register.
REDACTLY_BIND=127.0.0.1

# -------------------------------------------------------------------- webmcp ---
# Chrome origin trial token, bound to the exact origin you serve from, scheme
# and host included. Register at https://developer.chrome.com/origintrials.
# Without it the page installs the WebMCP polyfill instead of using the native
# API. Read per request, so changing it is a restart rather than a rebuild.
WEBMCP_ORIGIN_TRIAL_TOKEN=

# ------------------------------------------------------------------- runtime ---
# How long a tool call waits for a human to approve or deny. Your reverse proxy
# read timeout must exceed this or the proxy will cut the approval off mid-wait.
REDACTLY_APPROVAL_TIMEOUT_SECONDS=180

# Base64-encoded 32 bytes. Left empty, one is generated into the state volume on
# first boot — fine while the key and the database share that volume and are
# discarded together. Set it explicitly if you ever back the database up.
REDACTLY_MASTER_KEY=
